{
  "version": 1,
  "fixtures": {
    "single-script": {
      "profile": {
        "type_regex": "cli|script|command",
        "fallback": false,
        "tier": "small"
      },
      "areas": {
        "code-quality": true,
        "architecture": true,
        "tech-stack": null,
        "tests": true,
        "security": true,
        "privacy": true,
        "data-integrity": null,
        "performance": true,
        "accessibility": null,
        "content-branding": null,
