          "checked_at": ["quick", "standard"]
        },
        {
          "id": "doc-command-missing",
          "areas": ["feature-completeness"],
          "check": "command|doc|readme|missing|undocumented|not-exist|nonexistent|drift",
          "paths": ["README.md"],
          "checked_at": ["standard"],
          "gap_area": "feature-completeness"
        }
