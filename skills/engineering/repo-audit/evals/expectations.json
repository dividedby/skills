        "feature-completeness": null,
        "repo-hygiene": true,
        "ops-release": null,
        "external-facts": null,
        "agent-readiness": true
      },
      "planted": [
        {
          "id": "secret",
          "areas": ["security"],
          "check": "secret|token|credential",
          "paths": ["config.ini"],
          "checked_at": ["quick", "standard"]
        },
        {
          "id": "stale-constant",
          "areas": ["external-facts", "code-quality"],
          "check": "stale|expir|outdated|constant|valid",
          "paths": ["tool.py", "tool.orig.py"],
          "checked_at": ["quick", "standard"]
        },
        {
          "id": "duplicate-file",
          "areas": ["code-quality", "repo-hygiene"],
          "check": "dup|copy|identical|orig|old",
